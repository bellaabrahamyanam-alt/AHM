{
 "about": "Rule table shared by tests/php/ParityTest.php and tests/js/parity.test.js: the PHP store and the Node dev server must give the same verdict (ok / refused with a message matching `expect`). @P<n> = n-th place of the sample, @L0 = the sample layer, @C0 = its first category. Run in order on a fresh copy of the migrated sample.",
 "cases": [
  {
   "name": "place: minimal",
   "via": "save",
   "body": {
    "place": {
     "lat": 40.1,
     "lon": 44.5,
     "type": "village",
     "names": [
      {
       "lang": "en",
       "name": "x"
      }
     ]
    }
   },
   "expect": "ok"
  },
  {
   "name": "place: mountain with height",
   "via": "save",
   "body": {
    "place": {
     "lat": 40.1,
     "lon": 44.5,
     "type": "mountain",
     "names": [
      {
       "lang": "en",
       "name": "x"
      }
     ],
     "height_m": 5137
    }
   },
   "expect": "ok"
  },
  {
   "name": "place: with dates",
   "via": "save",
   "body": {
    "place": {
     "lat": 40.1,
     "lon": 44.5,
     "type": "town",
     "names": [
      {
       "lang": "en",
       "name": "x"
      }
     ],
     "date_from": {
      "fmt": "y",
      "ts": "1000-01-01T00:00:00Z",
      "mode": "exact",
      "ts_to": null
     },
     "date_to": {
      "fmt": "y",
      "ts": "1500-01-01T00:00:00Z",
      "mode": "exact",
      "ts_to": null
     }
    }
   },
   "expect": "ok"
  },
  {
   "name": "place: bad coordinates",
   "via": "save",
   "body": {
    "place": {
     "lat": 91,
     "lon": 44.5,
     "type": "village",
     "names": [
      {
       "lang": "en",
       "name": "x"
      }
     ]
    }
   },
   "expect": "bad coordinates"
  },
  {
   "name": "place: bad type",
   "via": "save",
   "body": {
    "place": {
     "lat": 40.1,
     "lon": 44.5,
     "type": "spaceport",
     "names": [
      {
       "lang": "en",
       "name": "x"
      }
     ]
    }
   },
   "expect": "bad type"
  },
  {
   "name": "place: no names",
   "via": "save",
