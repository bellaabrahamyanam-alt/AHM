    "place": {
     "lat": 40.1,
     "lon": 44.5,
     "type": "village",
     "names": []
    }
   },
   "expect": "at least one name"
  },
  {
   "name": "place: language outside the dictionary",
   "via": "save",
   "body": {
    "place": {
     "lat": 40.1,
     "lon": 44.5,
     "type": "village",
     "names": [
      {
       "lang": "zz",
       "name": "x"
      }
     ]
    }
   },
   "expect": "not in the list"
  },
  {
   "name": "place: mountain too high",
   "via": "save",
   "body": {
    "place": {
     "lat": 40.1,
     "lon": 44.5,
     "type": "mountain",
     "names": [
      {
       "lang": "en",
       "name": "x"
      }
     ],
     "height_m": 9001
    }
   },
   "expect": "height must be a whole number"
  },
  {
   "name": "place: mountain fractional height",
   "via": "save",
   "body": {
    "place": {
     "lat": 40.1,
     "lon": 44.5,
     "type": "mountain",
     "names": [
      {
       "lang": "en",
       "name": "x"
      }
     ],
     "height_m": 12.5
    }
   },
   "expect": "height must be a whole number"
  },
  {
   "name": "place: time stamp does not match its format",
